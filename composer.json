{
    "name": "coringawc/filament-acl",
    "description": "Contextual permissions for Filament resources, relation managers, and actions.",
    "keywords": [
        "coringawc",
        "laravel",
        "filament",
        "filament-plugin",
        "permissions",
        "acl"
    ],
    "homepage": "https://github.com/coringawc/filament-acl",
    "support": {
        "issues": "https://github.com/coringawc/filament-acl/issues",
        "source": "https://github.com/coringawc/filament-acl"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Argemiro Dias",
            "email": "nt_170@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-permission": "^7.0"
    },
    "require-dev": {
        "coringawc/filament-plugin-workbanch": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "orchestra/workbench": "^10.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoringaWc\\FilamentAcl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoringaWc\\FilamentAcl\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "refactor": "rector",
        "test": "phpunit",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:refactor": "rector --dry-run",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench filament:assets --ansi"
        ],
        "bootstrap:workbench": [
            "@build",
            "@fresh:workbench"
        ],
        "seed:workbench": "@php vendor/bin/testbench db:seed --class=Workbench\\\\Database\\\\Seeders\\\\DatabaseSeeder --ansi --no-interaction",
        "fresh:workbench": "@php vendor/bin/testbench migrate:fresh --seed --seeder=Workbench\\\\Database\\\\Seeders\\\\DatabaseSeeder --ansi --no-interaction",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "CoringaWc\\FilamentAcl\\FilamentPermissionServiceProvider"
            ],
            "aliases": {
                "FilamentPermission": "CoringaWc\\FilamentAcl\\Facades\\FilamentPermission"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
